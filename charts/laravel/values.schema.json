{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "secret", "efs", "mysql", "bootstrap", "backup", "restore"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 2
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "pattern": "^ghcr\\.io/bxota/" },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": ".+",
          "not": { "const": "latest" }
        }
      }
    },
    "secret": {
      "type": "object",
      "required": ["name", "passwordKey", "rootPasswordKey", "appKeyKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "rootPasswordKey": { "type": "string", "minLength": 1 },
        "appKeyKey": { "type": "string", "minLength": 1 }
      }
    },
    "efs": {
      "type": "object",
      "required": ["server", "dataOwner", "backupOwner"],
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "dataOwner": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "backupOwner": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
      }
    },
    "mysql": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["registry", "repository", "tag"],
          "properties": {
            "registry": { "const": "ghcr.io" },
            "repository": { "type": "string", "pattern": "^bxota/" },
            "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["image", "resources"],
      "properties": {
        "image": { "type": "string", "pattern": "^ghcr\\.io/bxota/[^:]+:.+" }
      }
    },
    "backup": {
      "type": "object",
      "required": ["image", "retentionDays", "runAsUser", "resources", "restoreTestResources"],
      "properties": {
        "image": { "type": "string", "pattern": "^ghcr\\.io/bxota/[^:]+:.+" },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "runAsUser": { "type": "integer", "minimum": 1 }
      }
    },
    "restore": {
      "type": "object",
      "required": ["enabled", "dumpFile"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dumpFile": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "dumpFile": { "type": "string", "pattern": "^app-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.sql\\.gz$" }
        }
      }
    }
  }
}
